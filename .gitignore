# Keep generated outputs ignored by default, but version the compact sizing
# decisions required to reproduce the operational campaigns on another clone.
/outputs/*
!/outputs/sizing-sweep/
!/outputs/sizing-sweep/**
tmp/
/figures/
predictions/
PV Profiles/
.old/

# Compact solved artifacts under outputs/sizing-sweep are intentional repository
# inputs and remain versionable across clones and commits.
# Paper sources and compact publication artifacts are intentionally versioned.

# Zenodo archives are built locally from versioned release manifests.  Keep the
# manifests and documentation, but never commit the large generated packages.
/release/zenodo/packages/
